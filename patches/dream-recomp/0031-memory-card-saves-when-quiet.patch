+
+void MemoryCard::flush() {
+    if (!dirty_)
+        return;
+    if (save()) {
+        dirty_ = false;
+        ++saves;
+    } else {
+        quiet_frames_ = 0;  // try again after another quiet stretch
+    }
+}
