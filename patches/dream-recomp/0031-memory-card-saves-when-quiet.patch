diff --git a/runtime/tests/test_memcard.cpp b/runtime/tests/test_memcard.cpp
index f5e3923..f58da19 100644
--- a/runtime/tests/test_memcard.cpp
+++ b/runtime/tests/test_memcard.cpp
@@ -161,3 +161,50 @@ TEST_CASE("a formatted card survives the round trip through a file") {
     CHECK(b.formatted());
     CHECK(b.image() == a.image());
 }
+
+// ZombieRev-nx: block writes are saved once the card goes quiet, not on every write.
+TEST_CASE("block writes reach the file after a quiet stretch, or at flush") {
+    using dream::maple::Payload;
+    const auto dir = temp_dir();
+    const auto p = dir / "deferred.bin";
+    auto read_file = [&] {
+        std::ifstream in(p, std::ios::binary);
+        return std::vector<std::uint8_t>(std::istreambuf_iterator<char>(in), {});
+    };
+    // The request word as the bus delivers it (byte-swapped): block 10, phase 1.
+    auto write = [](MemoryCard& c, std::uint8_t value) {
+        std::array<std::uint32_t, 2 + 32> args{};
+        args[0] = dream::maple::kStorage;
+        const std::uint32_t request = (1u << 16) | 10u;
+        args[1] = ((request & 0xFF) << 24) | ((request & 0xFF00) << 8) |
+                  ((request >> 8) & 0xFF00) | (request >> 24);
+        for (std::size_t i = 2; i < args.size(); ++i) args[i] = value * 0x01010101u;
+        Payload out;
+        return c.handle(dream::maple::kBlockWrite, args.data(), args.size(), out);
+    };
+    const std::size_t at = 10 * MemoryCard::kBlockSize + MemoryCard::kBlockSize / 4;
+    {
+        MemoryCard c;
+        c.format();
+        REQUIRE(c.save_as(p.string()));
+        CHECK(write(c, 0xAB) == dream::maple::kDeviceReply);
+        CHECK(c.image()[at] == 0xAB);
+        CHECK(read_file()[at] == 0x00);  // not yet on disk
+        for (unsigned i = 0; i + 1 < MemoryCard::kQuietFrames; ++i) c.vblank();
+        CHECK(read_file()[at] == 0x00);
+        c.vblank();
+        CHECK(read_file()[at] == 0xAB);  // saved after the quiet stretch
+        CHECK(c.saves == 1);
+        for (unsigned i = 0; i < 100; ++i) c.vblank();
+        CHECK(c.saves == 1);  // nothing new, nothing saved
+
+        CHECK(write(c, 0xCD) == dream::maple::kDeviceReply);
+        c.flush();
+        CHECK(read_file()[at] == 0xCD);
+        CHECK(write(c, 0xEF) == dream::maple::kDeviceReply);
+    }
+    CHECK(read_file()[at] == 0xEF);  // the destructor saved the last write
+    MemoryCard none;  // no path: writes are refused, as before
+    none.format();
+    CHECK(write(none, 0x11) == dream::maple::kFileError);
+}
