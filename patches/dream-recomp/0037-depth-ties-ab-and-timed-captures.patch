diff --git a/render/include/dream/render/vk/renderer.h b/render/include/dream/render/vk/renderer.h
index b0dec81..bbd8f87 100644
--- a/render/include/dream/render/vk/renderer.h
+++ b/render/include/dream/render/vk/renderer.h
@@ -76,6 +76,11 @@ public:
     // triangle keyed on its farthest vertex (Flycast's default, "per triangle"): closer to the
     // hardware than per strip, much cheaper than per pixel, still not exact.
     bool sort_triangles = false;
+    // CT2-nx: how opaque and punch-through depth is written (geometry.frag): 0 as computed,
+    // 1 a tiny bias toward passing for the non-strict comparisons (greater-or-equal, less-or-equal),
+    // so a polygon drawn on the same plane as one already there wins the tie every time, 2 rounded
+    // to 2^-20 so near-equal values compare equal. Painted road lines flickered in Crazy Taxi 2.
+    int depth_variant = 0;
 
     // SA-nx: pipelines built ahead of play. `path` holds the driver's pipeline cache (compiled
     // shader code) and, beside it with ".keys" appended, the list of pipeline variants earlier runs
diff --git a/render/shaders/geometry.frag b/render/shaders/geometry.frag
index 4e43480..2439d32 100644
--- a/render/shaders/geometry.frag
+++ b/render/shaders/geometry.frag
@@ -40,5 +40,20 @@ void main() {
         discard;
 
     o_colour = clamp(colour, 0.0, 1.0);
-    gl_FragDepth = pvr_depth(v_uv.z);
+    // CT2-nx: Renderer::depth_variant (bits 16-17) for polygons on the same plane as one drawn
+    // before them, such as painted road lines: two triangles interpolate 1/w a hair apart, so a
+    // tie the hardware's comparison would pass came out either way from pixel to pixel and frame
+    // to frame. Bits 7-9 are the comparison (6 greater-or-equal, 3 less-or-equal; nearer is larger).
+    float d = pvr_depth(v_uv.z);
+    const int variant = (push.mode >> 16) & 3;
+    const int compare = (push.mode >> 7) & 7;
+    if (variant == 1) {
+        if (compare == 6)
+            d += 1.0e-6;
+        else if (compare == 3)
+            d -= 1.0e-6;
+    } else if (variant == 2) {
+        d = floor(d * 1048576.0 + 0.5) / 1048576.0;
+    }
+    gl_FragDepth = d;
 }
