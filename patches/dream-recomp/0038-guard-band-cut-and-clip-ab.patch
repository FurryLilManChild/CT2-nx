diff --git a/render/tests/test_guard_band.cpp b/render/tests/test_guard_band.cpp
new file mode 100644
index 0000000..fba991a
--- /dev/null
+++ b/render/tests/test_guard_band.cpp
@@ -0,0 +1,161 @@
+// CT2-nx: cutting far-reaching strips (guard_band.h). What has to hold: nothing changes on screen
+// (1/w and the perspective-correct attributes at any pixel inside the band are what the uncut
+// triangle gives there), every piece faces the way its triangle faced, and frames with nothing to
+// cut are passed through untouched.
+#include <cmath>
+#include <cstdint>
+#include <vector>
+
+#include "dream/render/guard_band.h"
+
+#include "doctest.h"
+
+namespace {
+
+using namespace dream::render;
+
+struct Sample {
+    bool hit = false;
+    double z = 0, u = 0, v = 0, red = 0;
+};
+
+// The exact value at (px, py) of the triangle (a, b, c), as the shader computes it: 1/w linear,
+// the attributes linear after multiplying by 1/w and divided back out.
+Sample sample(const Vertex& a, const Vertex& b, const Vertex& c, double px, double py) {
+    Sample s;
+    const double d = (double(b.y) - c.y) * (double(a.x) - c.x) + (double(c.x) - b.x) * (double(a.y) - c.y);
+    if (d == 0)
+        return s;
+    const double w0 = ((double(b.y) - c.y) * (px - c.x) + (double(c.x) - b.x) * (py - c.y)) / d;
+    const double w1 = ((double(c.y) - a.y) * (px - c.x) + (double(a.x) - c.x) * (py - c.y)) / d;
+    const double w2 = 1 - w0 - w1;
+    if (w0 < 0 || w1 < 0 || w2 < 0)
+        return s;
+    s.hit = true;
+    s.z = w0 * a.z + w1 * b.z + w2 * c.z;
+    s.u = (w0 * a.u * a.z + w1 * b.u * b.z + w2 * c.u * c.z) / s.z;
+    s.v = (w0 * a.v * a.z + w1 * b.v * b.z + w2 * c.v * c.z) / s.z;
+    s.red = (w0 * double(a.base & 0xFF) * a.z + w1 * double(b.base & 0xFF) * b.z +
+             w2 * double(c.base & 0xFF) * c.z) / s.z;
+    return s;
+}
+
+double area(const Vertex& a, const Vertex& b, const Vertex& c) {
+    return (double(b.x) - a.x) * (double(c.y) - a.y) - (double(c.x) - a.x) * (double(b.y) - a.y);
+}
+
+// The triangle of the strip `p` that covers the point, in the order the strip draws it.
+Sample sample_frame(const Frame& f, const Polygon& p, double px, double py) {
+    for (std::uint32_t t = 0; t + 2 < p.count; ++t) {
+        const Vertex& a = f.vertices[p.first + t];
+        const Vertex& b = f.vertices[p.first + t + 1];
+        const Vertex& c = f.vertices[p.first + t + 2];
+        Sample s = sample(a, b, c, px, py);
+        if (s.hit)
+            return s;
+    }
+    return {};
+}
+
+Vertex vtx(float x, float y, float z, float u, float v, std::uint32_t base) {
+    Vertex r;
+    r.x = x;
+    r.y = y;
+    r.z = z;
+    r.u = u;
+    r.v = v;
+    r.base = base;
+    return r;
+}
+
+// Shaped like the Crazy Taxi 2 strip that flickered: two corners near the camera and far off
+// screen, two on screen, as a strip of four (two triangles, the second wound the other way).
+Frame far_strip() {
+    Frame f;
+    f.vertices = {vtx(-190717.5f, -62760.0f, 3.333333f, 9.6f, -52.0f, 0xFF102030u),
+                  vtx(231.3f, 94.3f, 0.002436f, 30.5f, -51.0f, 0xFFC0C0C0u),
+                  vtx(-167595.7f, -2000673.0f, 3.333333f, 16.4f, 0.0f, 0xFF405060u),
+                  vtx(235.1f, 122.9f, 0.002365f, 31.0f, -52.0f, 0xFF808080u)};
+    Polygon p;
+    p.first = 0;
+    p.count = 4;
+    p.isp = 0x93000000u;
+    p.tcw = 0x88070368u;
+    f.lists[0].push_back(p);
+    return f;
+}
+
+}  // namespace
+
+TEST_CASE("guard band: a frame that stays near the screen is passed through") {
+    Frame f;
+    f.vertices = {vtx(-500, -500, 0.01f, 0, 0, 0), vtx(900, 10, 0.01f, 1, 0, 0), vtx(10, 900, 0.01f, 0, 1, 0)};
+    Polygon p;
+    p.count = 3;
+    f.lists[0].push_back(p);
+    Frame scratch;
+    std::uint32_t cut = 99;
+    const GuardBand band;
+    const Frame& out = clip_to_guard_band(f, band, scratch, &cut);
+    CHECK(&out == &f);
+    CHECK(cut == 0);
+}
+
+TEST_CASE("guard band: cutting changes nothing inside the band") {
+    const Frame f = far_strip();
+    Frame scratch;
+    std::uint32_t cut = 0;
+    const GuardBand band;
+    const Frame& out = clip_to_guard_band(f, band, scratch, &cut);
+    REQUIRE(&out == &scratch);
+    CHECK(cut == 1);
+    for (const Vertex& v : out.vertices)
+        if (&v >= &out.vertices[f.vertices.size()]) {
+            CHECK(v.x >= band.left - band.margin - 0.01f);
+            CHECK(v.y >= band.top - band.margin - 0.01f);
+            CHECK(v.x <= band.right + band.margin + 0.01f);
+            CHECK(v.y <= band.bottom + band.margin + 0.01f);
+        }
+    // Every pixel the original covers on screen: the pieces cover it with the same values.
+    int covered = 0;
+    for (int y = 0; y < 480; y += 3)
+        for (int x = 0; x < 640; x += 3) {
+            const Sample want = sample_frame(f, f.lists[0][0], x + 0.5, y + 0.5);
+            Sample got;
+            for (const Polygon& q : out.lists[0]) {
+                got = sample_frame(out, q, x + 0.5, y + 0.5);
+                if (got.hit)
+                    break;
+            }
+            REQUIRE(want.hit == got.hit);
+            if (!want.hit)
+                continue;
+            ++covered;
+            CHECK(std::fabs(got.z - want.z) <= 1e-9 + 1e-6 * want.z);
+            CHECK(std::fabs(got.u - want.u) <= 1e-3);
+            CHECK(std::fabs(got.v - want.v) <= 1e-3);
+            CHECK(std::fabs(got.red - want.red) <= 1.0);  // colours are rounded to 8 bits
+        }
+    CHECK(covered > 100);
+}
+
+TEST_CASE("guard band: each piece faces the way its triangle did") {
+    const Frame f = far_strip();
+    Frame scratch;
+    const GuardBand band;
+    const Frame& out = clip_to_guard_band(f, band, scratch);
+    // Triangle 0 of the strip as drawn, and triangle 1 with the strip's swap undone.
+    const auto& v = f.vertices;
+    const double faces[2] = {area(v[0], v[1], v[2]), area(v[1], v[3], v[2])};
+    REQUIRE(!out.lists[0].empty());
+    for (const Polygon& q : out.lists[0]) {
+        REQUIRE(q.count == 3);
+        CHECK(q.isp == 0x93000000u);
+        CHECK(q.tcw == 0x88070368u);
+        const double a = area(out.vertices[q.first], out.vertices[q.first + 1], out.vertices[q.first + 2]);
+        CHECK(a != 0.0);
+        // Both triangles of this strip face the same way once the swap is undone.
+        CHECK((a > 0) == (faces[0] > 0));
+    }
+    CHECK((faces[0] > 0) == (faces[1] > 0));
+}
