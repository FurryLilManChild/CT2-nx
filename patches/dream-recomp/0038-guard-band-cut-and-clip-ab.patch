diff --git a/render/include/dream/render/guard_band.h b/render/include/dream/render/guard_band.h
new file mode 100644
index 0000000..b4f7fad
--- /dev/null
+++ b/render/include/dream/render/guard_band.h
@@ -0,0 +1,33 @@
+// CT2-nx: polygons that reach far beyond the screen, cut down before the GPU sees them.
+//
+// A game that clips to a near plane close to the camera sends the triangles of a wall or road
+// right beside it with corners up to millions of pixels off screen (Crazy Taxi 2: x -190,000,
+// y -2,000,000). Every GPU computes depth and texture coordinates across such a triangle in single
+// precision from those far corners, and how far off the result is depends on the GPU: on Mark's
+// AMD GPU a stone band 0.5% nearer than a wall behind it lost to that wall on some frames and won
+// on others, while a software renderer drew the same capture right every time. Cutting those
+// triangles to a band a little wider than the screen gives the GPU small numbers to work with.
+//
+// The cut is exact. The hardware's coordinates are already in screen space, where x, y, 1/w and
+// every attribute multiplied by 1/w vary linearly, so a new corner on a cut edge is a linear blend
+// of the two old ones and the picture inside the band does not change.
+#pragma once
+#include <cstdint>
+#include "dream/render/display_list.h"
+
+namespace dream::render {
+
+struct GuardBand {
+    float left = 0, top = 0, right = 640, bottom = 480;  // the screen, in guest pixels
+    // A strip is cut only when a vertex lies more than `reach` beyond the screen; its triangles are
+    // then cut to `margin` beyond it. The edges a cut makes are all off screen.
+    float reach = 1024, margin = 256;
+};
+
+// Returns `in` itself when no strip reaches beyond the band, otherwise `scratch`, filled with a
+// copy of `in` in which every such strip is replaced by its triangles, cut, each a strip of three
+// with the winding the original triangle had. `cut` (when given) receives the number of strips cut.
+const Frame& clip_to_guard_band(const Frame& in, const GuardBand& band, Frame& scratch,
+                                std::uint32_t* cut = nullptr);
+
+}  // namespace dream::render
