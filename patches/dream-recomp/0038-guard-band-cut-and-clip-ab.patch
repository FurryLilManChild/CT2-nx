diff --git a/render/src/guard_band.cpp b/render/src/guard_band.cpp
new file mode 100644
index 0000000..4bb7300
--- /dev/null
+++ b/render/src/guard_band.cpp
@@ -0,0 +1,175 @@
+// CT2-nx: see guard_band.h.
+#include "dream/render/guard_band.h"
+
+#include <algorithm>
+#include <cmath>
+
+namespace dream::render {
+namespace {
+
+// A vertex in the form that varies linearly across the screen: position, 1/w, and every
+// attribute multiplied by 1/w (texture coordinates and the eight colour channels).
+struct Linear {
+    double x, y, z, u, v;
+    double c[8];
+};
+
+Linear to_linear(const Vertex& s) {
+    Linear l{};
+    l.x = s.x;
+    l.y = s.y;
+    l.z = s.z;
+    l.u = static_cast<double>(s.u) * s.z;
+    l.v = static_cast<double>(s.v) * s.z;
+    for (int k = 0; k < 4; ++k) {
+        l.c[k] = static_cast<double>((s.base >> (8 * k)) & 0xFFu) * s.z;
+        l.c[4 + k] = static_cast<double>((s.offset >> (8 * k)) & 0xFFu) * s.z;
+    }
+    return l;
+}
+
+Vertex from_linear(const Linear& l) {
+    Vertex s;
+    s.x = static_cast<float>(l.x);
+    s.y = static_cast<float>(l.y);
+    s.z = static_cast<float>(l.z);
+    s.u = static_cast<float>(l.u / l.z);
+    s.v = static_cast<float>(l.v / l.z);
+    std::uint32_t base = 0, offset = 0;
+    for (int k = 0; k < 4; ++k) {
+        const auto channel = [&](double c) {
+            return static_cast<std::uint32_t>(std::clamp(std::lround(c / l.z), 0L, 255L));
+        };
+        base |= channel(l.c[k]) << (8 * k);
+        offset |= channel(l.c[4 + k]) << (8 * k);
+    }
+    s.base = base;
+    s.offset = offset;
+    return s;
+}
+
+Linear blend(const Linear& a, const Linear& b, double t) {
+    Linear r;
+    r.x = a.x + (b.x - a.x) * t;
+    r.y = a.y + (b.y - a.y) * t;
+    r.z = a.z + (b.z - a.z) * t;
+    r.u = a.u + (b.u - a.u) * t;
+    r.v = a.v + (b.v - a.v) * t;
+    for (int k = 0; k < 8; ++k) r.c[k] = a.c[k] + (b.c[k] - a.c[k]) * t;
+    return r;
+}
+
+// One Sutherland-Hodgman pass: keeps the part of `in` where side(vertex) >= 0, side being linear.
+template <typename Side>
+void clip_pass(const std::vector<Linear>& in, std::vector<Linear>& out, Side side) {
+    out.clear();
+    const std::size_t n = in.size();
+    for (std::size_t i = 0; i < n; ++i) {
+        const Linear& a = in[i];
+        const Linear& b = in[(i + 1) % n];
+        const double da = side(a), db = side(b);
+        if (da >= 0)
+            out.push_back(a);
+        if ((da >= 0) != (db >= 0))
+            out.push_back(blend(a, b, da / (da - db)));
+    }
+}
+
+bool outside(const Vertex& v, float x0, float y0, float x1, float y1) {
+    return !(v.x >= x0 && v.x <= x1 && v.y >= y0 && v.y <= y1);  // NaN counts as outside
+}
+
+}  // namespace
+
+const Frame& clip_to_guard_band(const Frame& in, const GuardBand& band, Frame& scratch,
+                                std::uint32_t* cut) {
+    const float rx0 = band.left - band.reach, ry0 = band.top - band.reach;
+    const float rx1 = band.right + band.reach, ry1 = band.bottom + band.reach;
+    const auto needs_cut = [&](const Polygon& p) {
+        for (std::uint32_t i = 0; i < p.count; ++i)
+            if (outside(in.vertices[p.first + i], rx0, ry0, rx1, ry1))
+                return true;
+        return false;
+    };
+    bool any = false;
+    for (const auto& list : in.lists)
+        for (const Polygon& p : list)
+            if (needs_cut(p)) {
+                any = true;
+                break;
+            }
+    if (cut)
+        *cut = 0;
+    if (!any)
+        return in;
+
+    const double mx0 = band.left - band.margin, my0 = band.top - band.margin;
+    const double mx1 = band.right + band.margin, my1 = band.bottom + band.margin;
+    scratch.vertices = in.vertices;
+    scratch.modifiers = in.modifiers;
+    scratch.min_z = in.min_z;
+    scratch.max_z = in.max_z;
+    scratch.strips = in.strips;
+    scratch.sprites = in.sprites;
+    scratch.dropped_vertices = in.dropped_vertices;
+    scratch.unknown_parameters = in.unknown_parameters;
+    std::vector<Linear> poly, tmp;
+    for (std::size_t l = 0; l < in.lists.size(); ++l) {
+        auto& out_list = scratch.lists[l];
+        out_list.clear();
+        for (const Polygon& p : in.lists[l]) {
+            if (!needs_cut(p)) {
+                out_list.push_back(p);
+                continue;
+            }
+            if (cut)
+                ++*cut;
+            const auto emit = [&](const Vertex& a, const Vertex& b, const Vertex& c) {
+                Polygon q = p;
+                q.first = static_cast<std::uint32_t>(scratch.vertices.size());
+                q.count = 3;
+                scratch.vertices.push_back(a);
+                scratch.vertices.push_back(b);
+                scratch.vertices.push_back(c);
+                out_list.push_back(q);
+            };
+            for (std::uint32_t t = 0; t + 2 < p.count; ++t) {
+                // Every second triangle of a strip is wound the other way; on its own, as a strip
+                // of three, it is given the order that faces the way it faced in the strip.
+                const Vertex& a = in.vertices[p.first + t];
+                const Vertex& b = in.vertices[p.first + t + ((t & 1u) ? 2u : 1u)];
+                const Vertex& c = in.vertices[p.first + t + ((t & 1u) ? 1u : 2u)];
+                const double area = (static_cast<double>(b.x) - a.x) * (static_cast<double>(c.y) - a.y) -
+                                    (static_cast<double>(c.x) - a.x) * (static_cast<double>(b.y) - a.y);
+                if (area == 0.0 || std::isnan(area))
+                    continue;  // draws nothing either way
+                const bool inside = !outside(a, static_cast<float>(mx0), static_cast<float>(my0),
+                                             static_cast<float>(mx1), static_cast<float>(my1)) &&
+                                    !outside(b, static_cast<float>(mx0), static_cast<float>(my0),
+                                             static_cast<float>(mx1), static_cast<float>(my1)) &&
+                                    !outside(c, static_cast<float>(mx0), static_cast<float>(my0),
+                                             static_cast<float>(mx1), static_cast<float>(my1));
+                // 1/w at or below zero would make the attributes meaningless to divide back out;
+                // such a triangle is left as the game sent it.
+                if (inside || !(a.z > 0 && b.z > 0 && c.z > 0)) {
+                    emit(a, b, c);
+                    continue;
+                }
+                poly = {to_linear(a), to_linear(b), to_linear(c)};
+                clip_pass(poly, tmp, [&](const Linear& v) { return v.x - mx0; });
+                clip_pass(tmp, poly, [&](const Linear& v) { return mx1 - v.x; });
+                clip_pass(poly, tmp, [&](const Linear& v) { return v.y - my0; });
+                clip_pass(tmp, poly, [&](const Linear& v) { return my1 - v.y; });
+                if (poly.size() < 3)
+                    continue;  // wholly outside the band, so off screen
+                // A fan keeps the triangle's winding.
+                const Vertex v0 = from_linear(poly[0]);
+                for (std::size_t k = 1; k + 1 < poly.size(); ++k)
+                    emit(v0, from_linear(poly[k]), from_linear(poly[k + 1]));
+            }
+        }
+    }
+    return scratch;
+}
+
+}  // namespace dream::render
