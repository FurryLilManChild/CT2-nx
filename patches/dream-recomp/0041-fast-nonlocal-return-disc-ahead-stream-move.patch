 #include <stdexcept>
@@ -320,13 +321,48 @@ bool trace_nonlocal() {
     static const bool on = std::getenv("DREAM_TRACE_NONLOCAL") != nullptr;
     return on;
 }
+
+// CT2-nx (switch-test3): a non-local return straight to run_guest. Crazy Taxi 2's task system
+// longjmps (the game's own setjmp/longjmp at 0x0C095CCC/0x0C095C58) many times a frame, and
+// throwing NonLocalReturn for each was about 4% of the game thread in switch-test2's slow
+// stretches, almost all of it in the unwinder. When nothing between the innermost run_guest and
+// the returning code needs unwinding, nonlocal_return jumps there with longjmp instead.
+//
+// What may lie between: translated functions (plain data only: no destructors, no handlers) and
+// the runtime's own plain dispatch (call_indirect's direct call, jump_indirect, resume_at,
+// idle_empty_fn). Every runtime frame that does need unwinding holds an UnwindGuard while it runs
+// guest code (call_indirect's resume path, which restores g_call_into; each hook: interrupts,
+// TRAPA, RTE, the interpreter). run_guest notes the guard count when it arms; a count that has
+// moved since means such a frame is live, and the return throws as before.
+thread_local int g_unwind_guard = 0;
+struct UnwindGuard {
+    UnwindGuard() noexcept { ++g_unwind_guard; }
+    ~UnwindGuard() { --g_unwind_guard; }
+    UnwindGuard(const UnwindGuard&) = delete;
+    UnwindGuard& operator=(const UnwindGuard&) = delete;
+};
+struct FastReturn {
+    std::jmp_buf jb;
+    int guard_at = 0;
+    std::uint32_t pc = 0;
+};
+thread_local FastReturn* g_fast = nullptr;
+NonLocalStats g_nonlocal_stats;
 }  // namespace
 
+NonLocalStats nonlocal_stats() { return g_nonlocal_stats; }
+
 void nonlocal_return(Ctx& c, ::dream::Memory&, std::uint32_t pc) {
     if (trace_nonlocal())
         std::fprintf(stderr, "nonlocal: rts from pc 0x%08x to 0x%08x (r15 0x%08x)\n", c.pc, pc,
                      c.r[15]);
     c.pc = pc;
+    if (FastReturn* f = g_fast; f && f->guard_at == g_unwind_guard) {
+        ++g_nonlocal_stats.fast;
+        f->pc = pc;
+        std::longjmp(f->jb, 1);
+    }
+    ++g_nonlocal_stats.thrown;
     throw NonLocalReturn{pc};
 }
 
